//@aux-build: proc_macros.rs

#![warn(clippy::mistyped_literal_suffixes)]
#![expect(
    overflowing_literals,
    unused_comparisons,
    clippy::inconsistent_digit_grouping,
    clippy::no_effect
)]
#![allow(clippy::zero_prefixed_literal)]

extern crate proc_macros;
use proc_macros::{external, inline_macros, with_span};

macro_rules! assert_eq {
    ($lhs:expr, $rhs1:expr, $rhs2:expr $(,)?) => {{
        let lhs = $lhs;
        assert!(lhs == $rhs1 || lhs == $rhs2);
    }};
}

#[inline_macros]
const _: () = {
    assert_eq!(0_u8, 0, 8); //~ mistyped_literal_suffixes
    assert_eq!(0_u16, 0, 16); //~ mistyped_literal_suffixes
    assert_eq!(0_u32, 0, 32); //~ mistyped_literal_suffixes
    assert_eq!(0_u64, 0, 64); //~ mistyped_literal_suffixes

    // Maximum value for signed suggestion.
    assert_eq!(127_u8, 127, 1278); //~ mistyped_literal_suffixes
    assert_eq!(32_767_u16, 32_767, 3_276_716); //~ mistyped_literal_suffixes
    assert_eq!(2_147_483_647_u32, 2_147_483_647, 214_748_364_732); //~ mistyped_literal_suffixes
    assert_eq!(
        9_223_372_036_854_775_807_u64, //~ mistyped_literal_suffixes
        9_223_372_036_854_775_807,
        922_337_203_685_477_580_764,
    );

    // Only unsigned suggestion.
    assert_eq!(1_288, 128, 1288); //~ mistyped_literal_suffixes
    assert_eq!(3_276_816, 32_768, 3_276_816); //~ mistyped_literal_suffixes
    assert_eq!(214_748_364_832, 2_147_483_648, 214_748_364_832); //~ mistyped_literal_suffixes
    assert_eq!(
        922_337_203_685_477_580_864, //~ mistyped_literal_suffixes
        9_223_372_036_854_775_808,
        922_337_203_685_477_580_864,
    );

    // Float exponent
    assert_eq!(1.0e532, 1.0e5, 1.0e532); //~ mistyped_literal_suffixes
    assert_eq!(1.0e564, 1.0e5, 1.0e564); //~ mistyped_literal_suffixes

    // Octal
    assert_eq!(0o111_u16, 0o111, 0o11116); //~ mistyped_literal_suffixes
    assert_eq!(0o777_676_u32, 0o777_676, 0o77_767_632); //~ mistyped_literal_suffixes

    // Hex
    assert_eq!(0x7F_u8, 0x7F, 0x7F8); //~ mistyped_literal_suffixes
    assert_eq!(0x0051_u16, 0x0051, 0x00_5116); //~ mistyped_literal_suffixes
    assert_eq!(0x7FFF_0000_u32, 0x7FFF_0000, 0x7F_FF00_0032); //~ mistyped_literal_suffixes
    assert_eq!(0x7abc_0000_1234_u64, 0x7abc_0000_1234, 0x7a_bc00_0012_3464); //~ mistyped_literal_suffixes

    // Internal macros
    inline! {
        assert_eq!(0_u8, 0, 8); //~ mistyped_literal_suffixes
        assert_eq!(0_u16, 0, 16); //~ mistyped_literal_suffixes
    }
};

fn main() {
    // Just the number.
    8;
    16;
    32;
    64;
    128;

    // Trailing underscore
    256_16_;
    256_32_;

    // With suffix
    256_16_u16;
    256_16u32;

    // 128 suffix.
    256_128;
    65_536_128;

    // Out of range of the target type.
    256_8;
    65_536_16;
    4_294_967_296_32;
    18_446_744_073_709_551_616_64;

    // No matching suffix number
    1000_17;
    1000_31;
    1000_63;

    // Just the number as the fractional part.
    1.8;
    1.16;
    1.32;
    1.64;

    // The final fractional group.
    1.000_000_8;
    1.000_000_16;
    1.000_000_32;
    1.000_000_64;

    with_span! {
        sp
        1000_16;
        1.0e5_32;
    }
    external! {
        1000_16;
        1.0e5_32;
    }
}
